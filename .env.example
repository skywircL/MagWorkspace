# Copy to .env and choose a local development password. Never commit .env.
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=33069
DATABASE_URL="magworkspace:replace-with-a-local-password@tcp(127.0.0.1:33069)/magworkspace?parseTime=true"
HTTP_ADDR=127.0.0.1:8080
ALLOW_REGISTRATION=true
# Disabled unless explicitly set to demo or live. demo is deterministic, not a model.
MAGENT_MODE=
# Go backend communicates only with the separately deployed HTTP service.
MAGENT_SERVICE_URL=http://127.0.0.1:18090
MAGENT_SERVICE_API_KEY=replace-with-harness-service-key
MAGENT_SERVICE_PORT=18090
MAGENT_SERVICE_MAX_CONCURRENCY=4
MAGENT_CALLBACK_ADDR=127.0.0.1:8081
MAGENT_CALLBACK_BASE_URL=http://127.0.0.1:8081
# The source below is mounted read-only by the Harness service, not the Go backend.
MAGENT_HARNESS_PATH="../Magent Harness"
MAGENT_TIMEOUT=120s
# Harness-service-owned model budgets; only recent authorized complete turns are hydrated.
MAGENT_MAX_CONTEXT_TOKENS=128000
MAGENT_RESERVE_TOKENS=16384
MAGENT_KEEP_RECENT_TOKENS=20000
MAGENT_MAX_SUMMARY_TOKENS=2048
MAGENT_MAX_COMPLETION_TOKENS=4096
MAGENT_SUMMARY_TIMEOUT=60s
# Live mode only. Use the provider API root, not the full /chat/completions URL.
# Native DeepSeek SSE uses https://api.deepseek.com (no /v1 required).
MAGENT_BASE_URL=https://api.openai.com/v1
MAGENT_API_KEY=
MAGENT_MODEL=

# Document processing: all services run in Docker. Host defaults shown here;
# Compose backend uses internal service addresses. No document data goes to LLMs.
DOCUMENT_INDEXING_ENABLED=true
# Only parent_child_v1 is supported for new processing and evaluation.
CHUNKING_STRATEGY=parent_child_v1
TIKA_URL=http://127.0.0.1:19998
EMBEDDING_BASE_URL=http://127.0.0.1:11435/v1
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
# Per batch, including provider queue time; caller/job deadlines still apply.
EMBEDDING_REQUEST_TIMEOUT=120s
QDRANT_URL=http://127.0.0.1:16333
QDRANT_PORT=16333
QDRANT_API_KEY=replace-with-qdrant-api-key
# Fixed per index profile; changing this requires rebuilding indexes.
BM25_AVG_LEN=256
INDEX_WORKERS=1
# Retry transient indexing errors; manual retry starts a fresh budget.
INDEX_MAX_RETRIES=3
INDEX_JOB_TIMEOUT=5m
# Qdrant performs both retrieval branches and RRF in one request.
RETRIEVAL_EXECUTION=qdrant_native

# Local metrics listener is separate from the authenticated application API.
# compose.observability.yaml opts into Docker Jaeger and Prometheus.
METRICS_ADDR=127.0.0.1:9091
METRICS_PORT=19091
TRACING_ENABLED=false
TRACING_SAMPLE_RATIO=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
LOG_LEVEL=INFO
APP_ENV=development
JAEGER_PORT=16686
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=19090

# Private original files and parsed artifacts; init-env.py generates credentials.
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_BUCKET=magworkspace
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# Knowledge file upload limit in MiB; integer 1..512. Restart backend after changing.
MAX_FILE_SIZE_MB=50

# Redis: dispatch, transient progress and SSE replay; MySQL remains authoritative.
STREAM_MANAGER_TYPE=memory
REDIS_ADDR=127.0.0.1:16379
REDIS_PORT=16379
REDIS_PASSWORD=replace-with-redis-password

# Local cross-encoder reranking. Docker TEI uses the pinned CPU model revision.
RERANK_ENABLED=true
RERANK_API_KEY=replace-with-reranker-api-key
RERANK_PORT=18091
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_MODEL_REVISION=1427fd652930e4ba29e8149678df786c240d8825
RERANK_MAX_CANDIDATES=10
RERANK_THRESHOLD=0.2
RERANK_MAX_PASSAGE_RUNES=2048
RERANK_MAX_INPUT_TOKENS=1024
RERANK_REQUEST_TIMEOUT=30s

# Explicit previous destinations for resource cleanup and historical file reads.
# Credentials are environment variable names, never database fields. For Compose,
# inject additional referenced credential variables through a local override.
# See docs/decisions/038-resource-cleanup-bindings.md for binding/recovery rules.
CLEANUP_QDRANT_STORES=[]
CLEANUP_MINIO_STORES=[]
